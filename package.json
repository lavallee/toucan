{
  "name": "toucan",
  "version": "0.22.0",
  "description": "An infinite canvas in the browser (tldraw or Excalidraw) that you edit by hand while agents edit it through a CLI and a built-in Codex chat.",
  "license": "MIT",
  "author": "Marc Lavallee <mlavallee@gmail.com>",
  "homepage": "https://lavallee.github.io/toucan/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lavallee/toucan.git"
  },
  "bugs": {
    "url": "https://github.com/lavallee/toucan/issues"
  },
  "keywords": [
    "tldraw",
    "excalidraw",
    "canvas",
    "agents",
    "codex",
    "mermaid",
    "json-canvas",
    "diagram"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "toucan": "bin/toucan.mjs"
  },
  "exports": {
    "./client": "./lib/client.mjs",
    "./tg": "./lib/tg.mjs"
  },
  "scripts": {
    "dev": "node server/index.mjs --dev & vite --config app/vite.config.ts",
    "build": "vite build --config app/vite.config.ts && rm -rf dist/excalidraw && mkdir -p dist/excalidraw && cp -r node_modules/@excalidraw/excalidraw/dist/prod/fonts dist/excalidraw/fonts",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit -p .",
    "css:preflight": "node scripts/scope-preflight.mjs",
    "test": "node scripts/tg-check.mjs && node scripts/trail-check.mjs && node scripts/versions-check.mjs && node scripts/routines-check.mjs && node scripts/brief-check.mjs && node scripts/activity-check.mjs && node scripts/threads-check.mjs && node scripts/layouts-check.mjs && node scripts/references-check.mjs && node scripts/worklog-check.mjs && node scripts/hosts-check.mjs && node scripts/profiles-check.mjs && node scripts/plugins-check.mjs && node scripts/plan-check.mjs && node scripts/onboard-check.mjs && node scripts/reflexes-check.mjs && node scripts/review-check.mjs && node scripts/renditions-check.mjs",
    "test:headless": "node scripts/headless-e2e.mjs",
    "test:diagrams": "node scripts/eval-diagrams.mjs",
    "eval:agent": "node scripts/eval-agent.mjs",
    "test:presence": "node scripts/presence-e2e.mjs",
    "test:activity": "node scripts/activity-e2e.mjs",
    "test:references": "node scripts/references-e2e.mjs",
    "test:routines": "node scripts/routines-e2e.mjs",
    "test:templates": "node scripts/templates-e2e.mjs",
    "test:plan": "node scripts/plan-e2e.mjs",
    "test:review": "node scripts/review-check.mjs --browser",
    "test:reflexes": "node scripts/reflexes-e2e.mjs",
    "test:renditions": "node scripts/renditions-e2e.mjs",
    "test:mcp-app": "node scripts/mcp-app-demo.mjs",
    "check": "node scripts/check-repo.mjs",
    "docs:version": "node scripts/docs-version.mjs --write",
    "docs": "npm run docs:version && node scripts/build-features.mjs && artoo build website",
    "prepack": "npm run build",
    "test:install": "node scripts/install-check.mjs"
  },
  "dependencies": {
    "@tldraw/sync-core": "5.5.2",
    "elkjs": "^0.12.0",
    "gifenc": "^1.0.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/geist": "5.3.0",
    "@lyra-forge/leyline": "file:vendor/lyra-forge-leyline-0.8.0.tgz",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/core": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@shadcn/react": "0.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tldraw/sync": "5.5.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.57.0",
    "radix-ui": "1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "4.21.5",
    "shiki": "4.5.0",
    "streamdown": "2.7.0",
    "tailwindcss": "4.3.3",
    "tldraw": "5.5.2",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "zod": "^4.6.7"
  },
  "private": true,
  "optionalDependencies": {
    "playwright-core": "^1.64.1"
  },
  "files": [
    "AGENTS.md",
    "CHANGELOG.md",
    "bin",
    "dist",
    "docs/agents",
    "examples",
    "install.sh",
    "lib",
    "routines",
    "server",
    "skills",
    "templates"
  ]
}
