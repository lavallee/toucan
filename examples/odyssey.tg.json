    "geo": "rectangle",
    "size": "xl"
   },
   "meta": {
    "detail": "\"For Scylla is not mortal; moreover she is savage, extreme, rude, cruel and invincible.\"\n\nBook XII, tr. Samuel Butler"
   }
  },
  {
