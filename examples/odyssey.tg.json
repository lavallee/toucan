  {
   "key": "muse",
   "text": "The poem opens\nBook I",
   "box": {
    "x": 0,
    "y": 0,
    "w": 400,
    "h": 150
   },
   "style": {
    "color": "blue",
    "fill": "semi",
    "dash": "solid",
    "geo": "rectangle",
    "size": "xl"
   },
   "meta": {
    "detail": "\"Tell me, O Muse, of that ingenious hero who travelled far and wide after he had sacked the famous town of Troy.\"\n\nBook I, tr. Samuel Butler"
   }
  },
  {
   "key": "assembly",
   "text": "Telemachus speaks up\nBook II",
   "box": {
    "x": 600,
    "y": 0,
    "w": 400,
    "h": 150
   },
   "style": {
    "color": "blue",
    "fill": "semi",
    "dash": "solid",
    "geo": "rectangle",
    "size": "xl"
   },
   "meta": {
    "detail": "\"Men of Ithaca,” he said, “hear my words.\"\n\nBook II, tr. Samuel Butler"
   }
  },
  {
   "key": "pylos",
   "text": "Pylos: Nestor\nBook III",
   "box": {
    "x": 1200,
    "y": 0,
    "w": 400,
    "h": 150
   },
   "style": {
    "color": "green",
    "fill": "semi",
    "dash": "solid",
    "geo": "rectangle",
    "size": "xl"
   },
   "meta": {
    "detail": "\"But how, Mentor,” replied Telemachus, “dare I go up to Nestor, and how am I to address him?\"\n\nBook III, tr. Samuel Butler"
   }
  },
  {
   "key": "sparta",
