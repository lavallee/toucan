    "size": "xl"
   },
   "meta": {
    "detail": "\"First you will come to the Sirens who enchant all who come near them.\"\n\nBook XII, tr. Samuel Butler"
   }
  },
  {
   "key": "scylla",
   "text": "Scylla and Charybdis\nBook XII",
   "box": {
    "x": 1800,
    "y": 1320,
    "w": 400,
    "h": 150
   },
   "style": {
